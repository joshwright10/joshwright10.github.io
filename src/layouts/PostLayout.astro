---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import MermaidRenderer from '../components/MermaidRenderer.astro';
import Giscus from '../components/Giscus.astro';
import { withBase } from '../utils/paths';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface AdjacentPost {
  id: string;
  title: string;
}

interface Props {
  title: string;
  date: Date;
  description?: string;
  tags?: string[];
  headings?: Heading[];
  body?: string;
  draft?: boolean;
  prevPost?: AdjacentPost | null;
  nextPost?: AdjacentPost | null;
  relatedPosts?: AdjacentPost[];
}

const {
  title,
  date,
  description,
  tags = [],
  headings = [],
  body = '',
  draft = false,
  prevPost = null,
  nextPost = null,
  relatedPosts = [],
} = Astro.props;

const wordCount = body.trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 215));

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={date.toISOString()}
  tags={tags}
>
  <!-- Warm Stone Editorial Header Band -->
  <header class="border-b border-[var(--border-subtle)] bg-[var(--bg-surface)]">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
      <div class="mb-5">
        <a
          href={withBase('/')}
          class="inline-flex items-center gap-1.5 text-xs font-medium text-[var(--text-muted)] transition hover:text-[var(--text-primary)]"
        >
          <span>←</span>
          <span>All articles</span>
        </a>
      </div>

      <div class="mb-3 flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[var(--accent-primary)]">
        {
          draft && (
            <span class="rounded bg-amber-500/15 px-2 py-0.5 font-mono text-[11px] font-semibold uppercase tracking-wider text-amber-700 dark:text-amber-300">
              Draft Preview (Unpublished)
            </span>
          )
        }
        {
          tags.slice(0, 4).map((tag, idx) => (
            <>
              {idx > 0 && <span class="text-[var(--border-hover)]">·</span>}
              <a href={withBase(`/tags/${tag}/`)} class="hover:underline">
                {tag.replace(/-/g, ' ')}
              </a>
            </>
          ))
        }
      </div>

      <h1 class="max-w-4xl text-2xl font-semibold tracking-tight text-[var(--text-primary)] sm:text-4xl lg:text-[2.65rem] lg:leading-[1.16]">
        {title}
      </h1>

      {
        description && (
          <p class="mt-4 max-w-3xl text-base leading-relaxed text-[var(--text-secondary)] sm:text-lg">
            {description}
          </p>
        )
      }

      <div class="mt-6 flex flex-wrap items-center gap-2 text-xs text-[var(--text-muted)]">
        <span class="font-medium text-[var(--text-primary)]">Josh Wright</span>
        <span>·</span>
        <time datetime={date.toISOString()}>{formattedDate}</time>
        <span>·</span>
        <span>{readingMinutes} min read</span>
      </div>
    </div>
  </header>

  <!-- 2-Column Content + Sticky "On this page" Rail -->
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
      <div class="lg:col-span-8 xl:col-span-9 min-w-0">
        <article class="studio-prose max-w-none">
          <slot />
        </article>

        <!-- Topics Footer -->
        {
          tags.length > 0 && (
            <div class="mt-12 flex flex-wrap items-center gap-2 border-t border-[var(--border-subtle)] pt-6">
              <span class="mr-2 text-xs font-medium text-[var(--text-muted)]">Topics:</span>
              {tags.map((tag) => (
                <a
                  href={withBase(`/tags/${tag}/`)}
                  class="rounded border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-2.5 py-1 text-xs text-[var(--text-secondary)] transition hover:border-[var(--border-hover)] hover:text-[var(--text-primary)]"
                >
                  {tag}
                </a>
              ))}
            </div>
          )
        }

        <!-- Prev / Next Navigation -->
        {
          (prevPost || nextPost) && (
            <nav
              aria-label="Adjacent articles"
              class="mt-10 grid grid-cols-1 gap-6 border-t border-[var(--border-subtle)] pt-8 sm:grid-cols-2"
            >
              {prevPost ? (
                <a href={withBase(`/posts/${prevPost.id}/`)} class="group block">
                  <span class="text-xs text-[var(--text-muted)]">← Previous article</span>
                  <span class="mt-1 block text-sm font-semibold text-[var(--text-primary)] group-hover:text-[var(--accent-primary)]">
                    {prevPost.title}
                  </span>
                </a>
              ) : (
                <div />
              )}

              {nextPost && (
                <a href={withBase(`/posts/${nextPost.id}/`)} class="group block sm:text-right">
                  <span class="text-xs text-[var(--text-muted)]">Next article →</span>
                  <span class="mt-1 block text-sm font-semibold text-[var(--text-primary)] group-hover:text-[var(--accent-primary)]">
                    {nextPost.title}
                  </span>
                </a>
              )}
            </nav>
          )
        }

        <!-- Related Articles -->
        {
          relatedPosts.length > 0 && (
            <section class="mt-10 border-t border-[var(--border-subtle)] pt-8">
              <h2 class="text-xs font-semibold uppercase tracking-widest text-[var(--text-muted)]">
                Related Reading
              </h2>
              <ul class="mt-3 space-y-2.5">
                {relatedPosts.map((rel) => (
                  <li>
                    <a
                      href={withBase(`/posts/${rel.id}/`)}
                      class="text-sm font-medium text-[var(--text-primary)] hover:text-[var(--accent-primary)] hover:underline"
                    >
                      {rel.title}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <!-- Giscus Comments -->
        <Giscus />
      </div>

      <!-- Desktop Sticky Sidebar -->
      <aside class="hidden lg:block lg:col-span-4 xl:col-span-3">
        <div class="sticky top-8 space-y-10">
          <TableOfContents headings={headings} />
        </div>
      </aside>
    </div>
  </div>

  <!-- Client-side Mermaid v11 Renderer & Interactive Toolbar -->
  <MermaidRenderer />
</BaseLayout>
