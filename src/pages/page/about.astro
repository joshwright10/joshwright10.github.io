---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CredlyGrid from '../../components/CredlyGrid.astro';
import Giscus from '../../components/Giscus.astro';
---

<BaseLayout
  title="About me"
  description="Josh Wright — Product builder based in Madrid with roots in Platform Engineering and DevOps."
>
  <!-- Warm Stone Masthead Band -->
  <section class="border-b border-[var(--border-subtle)] bg-[var(--bg-surface)]">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-widest text-[var(--text-muted)]">
          About
        </p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-[var(--text-primary)] sm:text-5xl">
          Josh Wright
        </h1>
        <p class="mt-4 text-base leading-relaxed text-[var(--text-secondary)] sm:text-lg">
          My name is Josh Wright. I am a Product Builder based in Madrid (originally from the UK), with a background in Platform Engineering and DevOps.
        </p>
        <div class="mt-5 flex items-center gap-5 text-sm font-medium text-[var(--accent-primary)]">
          <a
            href="https://github.com/joshwright10"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:underline"
          >
            GitHub ↗
          </a>
          <a
            href="https://www.linkedin.com/in/joshwright10"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:underline"
          >
            LinkedIn ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
      <div class="lg:col-span-8 space-y-10">
        <!-- Background -->
        <section class="space-y-3">
          <h2 class="text-lg font-semibold tracking-tight text-[var(--text-primary)]">
            My background
          </h2>
          <p class="text-base leading-relaxed text-[var(--text-secondary)]">
            I come from a Network focused SysAdmin background, starting my career working in the UK Football industry, helping to maintain business systems and also stadium network infrastructure, including the odd cable re-crimping on match day.
          </p>
          <p class="text-base leading-relaxed text-[var(--text-secondary)]">
            From there I moved into DevOps and then Platform Engineering — designing cloud infrastructure, Kubernetes platforms, and developer workflows on Azure — before transitioning into building products end-to-end.
          </p>
        </section>

        <!-- Skills & In Development -->
        <div class="grid grid-cols-1 gap-8 border-t border-[var(--border-subtle)] pt-10 sm:grid-cols-2">
          <section>
            <h2 class="text-lg font-semibold tracking-tight text-[var(--text-primary)]">
              My skills
            </h2>
            <ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-[var(--text-secondary)]">
              <li>PowerShell (this is where I am most comfortable writing code)</li>
              <li>Terraform</li>
              <li>Kubernetes</li>
              <li>Cloud: Azure</li>
              <li>Networking</li>
            </ul>
          </section>

          <section>
            <h2 class="text-lg font-semibold tracking-tight text-[var(--text-primary)]">
              In development
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
              The areas that I have a keen interest in, and where I have been working to improve my skills, but am not brave enough to own them yet.
            </p>
            <ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-[var(--text-secondary)]">
              <li>.NET</li>
              <li>Golang</li>
            </ul>
          </section>
        </div>

        <!-- Badges -->
        <section class="border-t border-[var(--border-subtle)] pt-10">
          <h2 class="text-lg font-semibold tracking-tight text-[var(--text-primary)]">
            My badges
          </h2>
          <div class="mt-6">
            <CredlyGrid />
          </div>
        </section>

        <Giscus />
      </div>
    </div>
  </div>
</BaseLayout>
