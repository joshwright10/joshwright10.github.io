---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CredlyGrid from '../../components/CredlyGrid.astro';
import Giscus from '../../components/Giscus.astro';
---

<BaseLayout
  title="About me"
  description="Josh Wright, a Product Builder based in Madrid with a background in Platform Engineering, DevOps, and Azure infrastructure."
>
  <!-- Warm Stone Masthead Band -->
  <section class="border-b border-[var(--border-subtle)] bg-[var(--bg-surface)]">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-widest text-[var(--text-muted)]">
          About
        </p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-[var(--text-primary)] sm:text-5xl">
          Josh Wright
        </h1>
        <p class="mt-4 text-base leading-relaxed text-[var(--text-secondary)] sm:text-lg">
          I am a Product Builder based in Madrid, originally from the UK, with a background in Platform Engineering, DevOps, and cloud infrastructure.
        </p>
        <div class="mt-5 flex items-center gap-5 text-sm font-medium text-[var(--accent-primary)]">
          <a
            href="https://github.com/joshwright10"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:underline"
          >
            GitHub ↗
          </a>
          <a
            href="https://www.linkedin.com/in/joshwright10"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:underline"
          >
            LinkedIn ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
      <div class="lg:col-span-8 space-y-10">
        <!-- Background -->
        <section class="space-y-4">
          <h2 class="text-lg font-semibold tracking-tight text-[var(--text-primary)]">
            Background
          </h2>
          <p class="text-base leading-relaxed text-[var(--text-secondary)]">
            I studied Forensic and Security Technologies at Sheffield Hallam University and started my career in the UK football industry at Sheffield Wednesday and Fulham FC, maintaining business systems and stadium network infrastructure (including the odd cable re-crimping on match day).
          </p>
          <p class="text-base leading-relaxed text-[var(--text-secondary)]">
            After moving to London, I worked across enterprise infrastructure, networking, and hybrid cloud at First State Investments and Euromoney. Relocating to Madrid, I built PowerShell automation frameworks for Fortune 500 clients at Nexthink before leading Azure platform direction, AKS migrations, and GitOps delivery for .NET workloads at Hitachi Digital Services.
          </p>
          <p class="text-base leading-relaxed text-[var(--text-secondary)]">
            Today I focus on building products end to end, backed by over a decade of hands-on experience in cloud platforms, developer tooling, and distributed systems. Outside of work, I play pádel, squash, and badminton, and speak Spanish and Russian.
          </p>
        </section>

        <!-- Core Stack -->
        <section class="border-t border-[var(--border-subtle)] pt-10">
          <h2 class="text-lg font-semibold tracking-tight text-[var(--text-primary)]">
            Core stack
          </h2>
          <div class="mt-4 grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-[var(--text-muted)]">
                Cloud & Infrastructure
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
                Azure (AKS, App Services, Functions, Storage, Networking, Apigee, Entra ID), Terraform, Ansible, PKI
              </p>
            </div>

            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-[var(--text-muted)]">
                Platform & Delivery
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
                Kubernetes, Argo CD, Docker, GitOps, Azure DevOps, GitHub, Helm, Kustomize, Backstage
              </p>
            </div>

            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-[var(--text-muted)]">
                Development & Automation
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
                .NET Core, ASP.NET Core, EF Core, PowerShell, Bash, YAML
              </p>
            </div>

            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-[var(--text-muted)]">
                Observability & Quality
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
                Prometheus, Grafana, Azure Monitor, SonarCloud, Checkmarx
              </p>
            </div>
          </div>
        </section>

        <!-- Badges -->
        <section class="border-t border-[var(--border-subtle)] pt-10">
          <h2 class="text-lg font-semibold tracking-tight text-[var(--text-primary)]">
            Certifications & badges
          </h2>
          <div class="mt-6">
            <CredlyGrid />
          </div>
        </section>

        <Giscus />
      </div>
    </div>
  </div>
</BaseLayout>
