---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVisiblePosts } from '../../utils/posts';
import { withBase } from '../../utils/paths';

const posts = await getVisiblePosts();

const tagMap = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags || []) {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  }
}

const sortedTags = Array.from(tagMap.entries()).sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0])
);
---

<BaseLayout title="Topics" description="Browse all technical topics on Josh Wright's blog.">
  <section class="border-b border-[var(--border-subtle)] bg-[var(--bg-surface)]">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-widest text-[var(--text-muted)]">
        Archive
      </p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-[var(--text-primary)] sm:text-5xl">
        Topics
      </h1>
      <p class="mt-3 text-base text-[var(--text-secondary)]">
        Browse {sortedTags.length} topics across {posts.length} articles.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-x-8 gap-y-3 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      {
        sortedTags.map(([tag, count]) => (
          <a
            href={withBase(`/tags/${tag}/`)}
            class="group flex items-baseline justify-between border-b border-[var(--border-subtle)] py-3 text-sm transition"
          >
            <span class="font-medium text-[var(--text-primary)] group-hover:text-[var(--accent-primary)]">
              {tag}
            </span>
            <span class="font-mono text-xs text-[var(--text-muted)]">
              {count}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
