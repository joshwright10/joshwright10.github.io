---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getVisiblePosts } from '../utils/posts';
import { withBase } from '../utils/paths';

const posts = await getVisiblePosts();
const [latestPost] = posts;

const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags || []) {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  }
}

const topTags = Array.from(tagCounts.entries())
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 12);
---

<BaseLayout
  title="DevOps Field Notes"
  description="Technical deep dives on Kubernetes, Azure, .NET, and platform engineering by Josh Wright."
>
  <!-- Tailscale-style Warm Stone Masthead Band -->
  <section class="border-b border-[var(--border-subtle)] bg-[var(--bg-surface)]">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-widest text-[var(--text-muted)]">
          Engineering Blog
        </p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-[var(--text-primary)] sm:text-5xl">
          DevOps Field Notes
        </h1>
        <p class="mt-4 text-base leading-relaxed text-[var(--text-secondary)] sm:text-lg">
          Technical deep dives, architecture notes, and real-world investigations across Kubernetes, Azure, .NET, and platform engineering.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Editorial Feed + Topic Rail -->
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <!-- Featured Latest Post -->
    {
      latestPost && (
        <section class="pb-12 border-b border-[var(--border-subtle)]" id="featured-post-section">
          <div class="mb-4 text-xs font-semibold uppercase tracking-widest text-[var(--text-muted)]">
            Latest Dispatch
          </div>
          <PostCard
            slug={latestPost.id}
            title={latestPost.data.title}
            date={latestPost.data.date}
            description={latestPost.data.description}
            tags={latestPost.data.tags}
            body={latestPost.body || ''}
            featured={true}
            draft={latestPost.data.draft}
          />
        </section>
      )
    }

    <!-- Asymmetric 12-Col Layout: Article Stream (8 cols) + Topic Sidebar (4 cols) -->
    <div class="mt-10 grid grid-cols-1 gap-12 lg:grid-cols-12">
      <!-- Article List -->
      <section class="lg:col-span-8" aria-label="Published articles">
        <div class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-3">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-[var(--text-muted)]" id="feed-heading">
            All Articles
          </h2>
          <button
            type="button"
            id="clear-filter-btn"
            class="hidden text-xs font-medium text-[var(--accent-primary)] hover:underline cursor-pointer"
          >
            Clear filter
          </button>
        </div>

        <div id="posts-grid" class="divide-y divide-[var(--border-subtle)]">
          {
            posts.map((post) => (
              <PostCard
                slug={post.id}
                title={post.data.title}
                date={post.data.date}
                description={post.data.description}
                tags={post.data.tags}
                body={post.body || ''}
                draft={post.data.draft}
              />
            ))
          }
        </div>
      </section>

      <!-- Right Sidebar (Topics & Author) -->
      <aside class="lg:col-span-4">
        <div class="sticky top-8 space-y-10 lg:border-l lg:border-[var(--border-subtle)] lg:pl-8">
          <!-- Topic Filter -->
          <div>
            <div class="flex items-center justify-between">
              <h2 class="text-xs font-semibold uppercase tracking-widest text-[var(--text-muted)]">
                Browse by Topic
              </h2>
              <a href={withBase('/tags/')} class="text-xs text-[var(--accent-primary)] hover:underline">
                All topics →
              </a>
            </div>

            <div class="mt-4 flex flex-wrap gap-1.5" id="tag-filter-bar">
              <button
                type="button"
                data-filter-tag="all"
                class="tag-filter-pill rounded border border-[var(--text-primary)] bg-[var(--text-primary)] px-2.5 py-1 text-xs font-medium text-[var(--bg-canvas)] transition cursor-pointer"
              >
                All
              </button>
              {
                topTags.map(([tag]) => (
                  <button
                    type="button"
                    data-filter-tag={tag}
                    class="tag-filter-pill rounded border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-2.5 py-1 text-xs text-[var(--text-secondary)] transition hover:border-[var(--border-hover)] hover:text-[var(--text-primary)] cursor-pointer"
                  >
                    {tag}
                  </button>
                ))
              }
            </div>
          </div>

          <!-- About Blurb -->
          <div class="border-t border-[var(--border-subtle)] pt-8">
            <h2 class="text-xs font-semibold uppercase tracking-widest text-[var(--text-muted)]">
              Written by
            </h2>
            <p class="mt-2 text-sm font-semibold text-[var(--text-primary)]">Josh Wright</p>
            <p class="mt-1.5 text-sm leading-relaxed text-[var(--text-secondary)]">
              DevOps consultant based in Madrid, originally from the UK. Working with PowerShell, Terraform, Kubernetes, and Azure.
            </p>
            <div class="mt-4 flex items-center gap-4 text-xs font-medium text-[var(--accent-primary)]">
              <a href={withBase('/page/about/')} class="hover:underline">More about Josh →</a>
              <a href={withBase('/rss.xml')} class="text-[var(--text-muted)] hover:text-[var(--text-primary)]">RSS Feed</a>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <script is:inline>
    (function () {
      const buttons = document.querySelectorAll('[data-filter-tag]');
      const feedCards = document.querySelectorAll('#posts-grid [data-post-card]');
      const featuredSection = document.getElementById('featured-post-section');
      const heading = document.getElementById('feed-heading');
      const clearBtn = document.getElementById('clear-filter-btn');

      function applyFilter(selected) {
        buttons.forEach((b) => {
          const active = b.getAttribute('data-filter-tag') === selected;
          if (active) {
            b.className =
              'tag-filter-pill rounded border border-[var(--text-primary)] bg-[var(--text-primary)] px-2.5 py-1 text-xs font-medium text-[var(--bg-canvas)] transition cursor-pointer';
          } else {
            b.className =
              'tag-filter-pill rounded border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-2.5 py-1 text-xs text-[var(--text-secondary)] transition hover:border-[var(--border-hover)] hover:text-[var(--text-primary)] cursor-pointer';
          }
        });

        if (featuredSection) {
          featuredSection.style.display = selected === 'all' ? '' : 'none';
        }
        if (heading) {
          heading.textContent = selected === 'all' ? 'All Articles' : `Topic: ${selected}`;
        }
        if (clearBtn) {
          clearBtn.classList.toggle('hidden', selected === 'all');
        }

        feedCards.forEach((card) => {
          const cardTags = (card.getAttribute('data-tags') || '').split(',');
          if (selected === 'all' || cardTags.includes(selected)) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      }

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          applyFilter(btn.getAttribute('data-filter-tag') || 'all');
        });
      });

      clearBtn?.addEventListener('click', () => applyFilter('all'));
    })();
  </script>
</BaseLayout>
