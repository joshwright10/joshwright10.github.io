<!-- Fullscreen Mermaid Lightbox Modal -->
<div
  id="mermaid-lightbox"
  class="fixed inset-0 z-50 hidden flex-col bg-black/75 p-4 sm:p-8"
  role="dialog"
  aria-modal="true"
  aria-label="Expanded Diagram"
>
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between rounded-t-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-4 py-2.5">
    <span class="text-xs font-medium text-[var(--text-secondary)]">Diagram View</span>
    <button
      type="button"
      id="mermaid-lightbox-close"
      class="mermaid-btn"
      aria-label="Close expanded diagram"
    >
      Close (Esc)
    </button>
  </div>
  <div
    id="mermaid-lightbox-content"
    class="mx-auto flex w-full max-w-6xl flex-1 items-center justify-center overflow-auto rounded-b-lg border border-t-0 border-[var(--border-subtle)] bg-[var(--bg-canvas)] p-6"
  ></div>
</div>

<script>
  function getMermaidConfig(theme: string) {
    const isLight = theme !== 'dark';
    return {
      startOnLoad: false,
      securityLevel: 'strict' as const,
      theme: 'base' as const,
      fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, sans-serif',
      flowchart: {
        htmlLabels: true,
        wrappingWidth: 320,
        padding: 14,
        curve: 'basis' as const,
      },
      themeVariables: isLight
        ? {
            background: '#ffffff',
            primaryColor: '#f6f5f1',
            primaryTextColor: '#191817',
            primaryBorderColor: '#b8b4ab',
            lineColor: '#53514e',
            secondaryColor: '#eef2ff',
            tertiaryColor: '#f6f5f1',
            clusterBkg: '#faf9f6',
            clusterBorder: '#dcd9d0',
            actorBkg: '#f6f5f1',
            actorBorder: '#3b5ccc',
            actorTextColor: '#191817',
            signalColor: '#191817',
            signalTextColor: '#191817',
            noteBkgColor: '#eef2ff',
            noteTextColor: '#191817',
            noteBorderColor: '#3b5ccc',
          }
        : {
            background: '#141413',
            primaryColor: '#1c1b19',
            primaryTextColor: '#f4f3ef',
            primaryBorderColor: '#4a4842',
            lineColor: '#b8b5ad',
            secondaryColor: '#222738',
            tertiaryColor: '#1c1b19',
            clusterBkg: '#181715',
            clusterBorder: '#33312d',
            actorBkg: '#1c1b19',
            actorBorder: '#7c9aff',
            actorTextColor: '#f4f3ef',
            signalColor: '#f4f3ef',
            signalTextColor: '#f4f3ef',
            noteBkgColor: '#222738',
            noteTextColor: '#f4f3ef',
            noteBorderColor: '#7c9aff',
          },
    };
  }

  async function renderAllMermaidDiagrams() {
    const wrappers = document.querySelectorAll<HTMLElement>('.mermaid-wrapper');
    if (!wrappers.length) return;

    let mermaid: any;
    try {
      ({ default: mermaid } = await import('mermaid'));
    } catch {
      const cdnUrl = 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
      ({ default: mermaid } = await import(/* @vite-ignore */ cdnUrl));
    }
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
    mermaid.initialize(getMermaidConfig(currentTheme));

    let index = 0;
    for (const wrapper of wrappers) {
      const encoded = wrapper.getAttribute('data-mermaid-code');
      const canvas = wrapper.querySelector<HTMLElement>('[data-mermaid-canvas]');
      if (!encoded || !canvas) continue;

      const code = decodeURIComponent(encoded);
      const id = `mermaid-svg-${Date.now()}-${index++}`;

      try {
        const { svg } = await mermaid.render(id, code);
        canvas.innerHTML = svg;
      } catch (err) {
        console.error('Mermaid render error:', err);
      }
    }
  }

  function bindMermaidControls() {
    const wrappers = document.querySelectorAll<HTMLElement>('.mermaid-wrapper');
    const lightbox = document.getElementById('mermaid-lightbox');
    const lightboxContent = document.getElementById('mermaid-lightbox-content');
    const lightboxClose = document.getElementById('mermaid-lightbox-close');

    wrappers.forEach((wrapper) => {
      if (wrapper.dataset.bound === 'true') return;
      wrapper.dataset.bound = 'true';

      let zoom = 1;
      const canvas = wrapper.querySelector<HTMLElement>('[data-mermaid-canvas]');
      const zoomLabel = wrapper.querySelector<HTMLElement>('[data-mermaid-zoom-level]');

      function applyZoom() {
        if (canvas) {
          canvas.style.transform = `scale(${zoom})`;
        }
        if (zoomLabel) {
          zoomLabel.textContent = `${Math.round(zoom * 100)}%`;
        }
      }

      wrapper.querySelectorAll<HTMLButtonElement>('[data-mermaid-action]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const action = btn.getAttribute('data-mermaid-action');
          if (action === 'zoom-in') {
            zoom = Math.min(2.25, +(zoom + 0.15).toFixed(2));
            applyZoom();
          } else if (action === 'zoom-out') {
            zoom = Math.max(0.5, +(zoom - 0.15).toFixed(2));
            applyZoom();
          } else if (action === 'reset') {
            zoom = 1;
            applyZoom();
          } else if (action === 'expand') {
            if (lightbox && lightboxContent && canvas) {
              lightboxContent.innerHTML = canvas.innerHTML;
              const svg = lightboxContent.querySelector('svg');
              if (svg) {
                svg.style.width = '100%';
                svg.style.maxWidth = '1000px';
                svg.style.height = 'auto';
              }
              lightbox.classList.remove('hidden');
              lightbox.classList.add('flex');
            }
          }
        });
      });
    });

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
    }

    lightboxClose?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightbox && !lightbox.classList.contains('hidden')) {
        closeLightbox();
      }
    });
  }

  renderAllMermaidDiagrams();
  bindMermaidControls();

  window.addEventListener('studio:theme-change', () => {
    renderAllMermaidDiagrams();
  });
</script>
