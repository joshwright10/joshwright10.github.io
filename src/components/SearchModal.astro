---
import { getVisiblePosts } from '../utils/posts';
import { withBase } from '../utils/paths';

const allPosts = await getVisiblePosts();

const searchIndex = allPosts.map((post) => ({
  slug: post.id,
  title: post.data.title,
  description: post.data.description || '',
  date: post.data.date.toISOString().slice(0, 10),
  tags: post.data.tags || [],
  draft: Boolean(post.data.draft),
  url: withBase(`/posts/${post.id}/`),
}));
---

<div
  id="search-modal"
  class="fixed inset-0 z-50 hidden items-start justify-center bg-black/50 p-4 pt-20"
  role="dialog"
  aria-modal="true"
  aria-label="Search articles"
>
  <div class="w-full max-w-xl overflow-hidden rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-canvas)] shadow-xl">
    <div class="flex items-center gap-3 border-b border-[var(--border-subtle)] px-4 py-3">
      <svg class="h-4 w-4 text-[var(--text-muted)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="Search articles by title or topic..."
        class="w-full bg-transparent text-sm text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none"
        autocomplete="off"
      />
      <button
        type="button"
        data-search-close
        class="rounded border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-2 py-0.5 font-mono text-[11px] text-[var(--text-muted)] hover:text-[var(--text-primary)] cursor-pointer"
      >
        Esc
      </button>
    </div>

    <div id="search-results" class="max-h-[60vh] overflow-y-auto divide-y divide-[var(--border-subtle)] px-2">
      <!-- Populated dynamically -->
    </div>
  </div>
</div>

<script is:inline define:vars={{ searchIndex }}>
  (function () {
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('search-input');
    const resultsContainer = document.getElementById('search-results');
    const triggers = document.querySelectorAll('[data-search-trigger]');
    const closeBtns = document.querySelectorAll('[data-search-close]');

    function renderItems(query) {
      if (!resultsContainer) return;
      const q = (query || '').trim().toLowerCase();
      const filtered = !q
        ? searchIndex
        : searchIndex.filter((item) => {
            const haystack = `${item.title} ${item.description} ${item.tags.join(' ')}`.toLowerCase();
            return haystack.includes(q);
          });

      if (filtered.length === 0) {
        resultsContainer.innerHTML = `
          <div class="py-8 text-center text-xs text-[var(--text-muted)]">
            No matching articles found.
          </div>
        `;
        return;
      }

      resultsContainer.innerHTML = filtered
        .map(
          (item) => `
          <a href="${item.url}" class="block py-3 px-2 transition hover:bg-[var(--bg-surface)] group">
            <div class="flex items-baseline justify-between gap-3">
              <span class="text-sm font-medium text-[var(--text-primary)] group-hover:text-[var(--accent-primary)]">
                ${item.draft ? '[Draft] ' : ''}${item.title}
              </span>
              <span class="font-mono text-xs text-[var(--text-muted)] shrink-0">${item.date}</span>
            </div>
            <div class="mt-1 flex flex-wrap gap-2 text-xs text-[var(--text-muted)]">
              ${item.tags.slice(0, 4).join(' · ')}
            </div>
          </a>
        `
        )
        .join('');
    }

    function openModal() {
      if (!modal) return;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      renderItems(input?.value || '');
      setTimeout(() => input?.focus(), 20);
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    triggers.forEach((btn) => btn.addEventListener('click', openModal));
    closeBtns.forEach((btn) => btn.addEventListener('click', closeModal));

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    input?.addEventListener('input', (e) => {
      renderItems(e.target.value);
    });

    input?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const firstLink = resultsContainer?.querySelector('a');
        if (firstLink) {
          window.location.href = firstLink.getAttribute('href');
        }
      }
    });

    window.addEventListener('keydown', (e) => {
      const isCmdK = (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k';
      const isSlash =
        e.key === '/' &&
        document.activeElement &&
        !['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName);

      if (isCmdK || isSlash) {
        e.preventDefault();
        openModal();
      } else if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  })();
</script>
