---
const pathname = Astro.url.pathname;
const isBlog = pathname === '/' || pathname.startsWith('/posts');
const isTags = pathname.startsWith('/tags');
const isAbout = pathname.startsWith('/page/about');
---

<header class="sticky top-0 z-40 w-full border-b border-[var(--border-subtle)] bg-[var(--bg-canvas)]/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand -->
    <a href="/" class="group flex items-center gap-3 text-[var(--text-primary)] transition">
      <div class="flex h-9 w-9 items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-elevated)] font-mono text-sm font-semibold shadow-sm transition group-hover:border-[var(--border-hover)]">
        <span class="text-[var(--accent-primary)]">&gt;</span><span class="text-[var(--accent-secondary)]">_</span>
      </div>
      <div class="flex flex-col">
        <span class="text-sm font-semibold tracking-tight text-[var(--text-primary)]">DevOps Field Notes</span>
        <span class="font-mono text-[11px] text-[var(--text-muted)]">joshwright10.github.io</span>
      </div>
    </a>

    <!-- Navigation & Actions -->
    <div class="flex items-center gap-1 sm:gap-2">
      <nav class="flex items-center gap-1 mr-1 sm:mr-2" aria-label="Primary Navigation">
        <a
          href="/"
          class:list={[
            'rounded-lg px-3 py-1.5 text-sm font-medium transition',
            isBlog
              ? 'bg-[var(--bg-elevated)] text-[var(--text-primary)] border border-[var(--border-subtle)]'
              : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-elevated)]/60',
          ]}
        >
          Articles
        </a>
        <a
          href="/tags/"
          class:list={[
            'rounded-lg px-3 py-1.5 text-sm font-medium transition',
            isTags
              ? 'bg-[var(--bg-elevated)] text-[var(--text-primary)] border border-[var(--border-subtle)]'
              : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-elevated)]/60',
          ]}
        >
          Tags
        </a>
        <a
          href="/page/about/"
          class:list={[
            'rounded-lg px-3 py-1.5 text-sm font-medium transition',
            isAbout
              ? 'bg-[var(--bg-elevated)] text-[var(--text-primary)] border border-[var(--border-subtle)]'
              : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-elevated)]/60',
          ]}
        >
          About
        </a>
      </nav>

      <!-- Search Trigger -->
      <button
        type="button"
        data-search-trigger
        class="flex items-center gap-2 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-2.5 py-1.5 text-xs text-[var(--text-secondary)] transition hover:border-[var(--border-hover)] hover:text-[var(--text-primary)] cursor-pointer"
        aria-label="Search articles (Cmd+K)"
        title="Search articles (⌘K or /)"
      >
        <svg class="h-3.5 w-3.5 text-[var(--text-muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden sm:inline">Search</span>
        <kbd class="hidden sm:inline-block rounded border border-[var(--border-subtle)] bg-[var(--bg-elevated)] px-1.5 py-0.5 font-mono text-[10px] text-[var(--text-muted)]">
          ⌘K
        </kbd>
      </button>

      <!-- Theme Toggle -->
      <button
        type="button"
        id="theme-toggle"
        class="flex h-8 w-8 items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] transition hover:border-[var(--border-hover)] hover:text-[var(--text-primary)] cursor-pointer"
        aria-label="Toggle color theme"
        title="Toggle dark/light theme"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg data-theme-icon="sun" class="h-4 w-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m8.66-11.66l-.7.7M4.04 19.96l-.7.7M21 12h-1M4 12H3m16.96 7.96l-.7-.7M4.74 4.74l-.7-.7M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg data-theme-icon="moon" class="h-4 w-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    const sun = btn?.querySelector('[data-theme-icon="sun"]');
    const moon = btn?.querySelector('[data-theme-icon="moon"]');

    function syncIcons(theme) {
      if (!sun || !moon) return;
      if (theme === 'light') {
        sun.classList.add('hidden');
        moon.classList.remove('hidden');
      } else {
        sun.classList.remove('hidden');
        moon.classList.add('hidden');
      }
    }

    const current = document.documentElement.getAttribute('data-theme') || 'dark';
    syncIcons(current);

    btn?.addEventListener('click', () => {
      const active = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = active === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      syncIcons(next);
      window.dispatchEvent(new CustomEvent('studio:theme-change', { detail: { theme: next } }));
    });
  })();
</script>
