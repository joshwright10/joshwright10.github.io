---
const pathname = Astro.url.pathname;
const isBlog = pathname === '/' || pathname.startsWith('/posts');
const isTags = pathname.startsWith('/tags');
const isAbout = pathname.startsWith('/page/about');
---

<header class="w-full border-b border-[var(--border-subtle)] bg-[var(--bg-surface)]">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand (Tailscale-inspired dot grid mark + clean typography) -->
    <div class="flex items-center gap-8">
      <a href="/" class="group flex items-center gap-3 text-[var(--text-primary)]">
        <svg class="h-5 w-5 text-[var(--text-primary)]" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <circle cx="3.5" cy="3.5" r="2" opacity="0.35" />
          <circle cx="10" cy="3.5" r="2" />
          <circle cx="16.5" cy="3.5" r="2" opacity="0.35" />
          <circle cx="3.5" cy="10" r="2" />
          <circle cx="10" cy="10" r="2" />
          <circle cx="16.5" cy="10" r="2" />
          <circle cx="3.5" cy="16.5" r="2" opacity="0.35" />
          <circle cx="10" cy="16.5" r="2" />
          <circle cx="16.5" cy="16.5" r="2" opacity="0.35" />
        </svg>
        <span class="text-base font-semibold tracking-tight text-[var(--text-primary)]">
          DevOps Field Notes
        </span>
      </a>

      <nav class="hidden sm:flex items-center gap-6" aria-label="Primary Navigation">
        <a
          href="/"
          class:list={[
            'text-sm font-medium transition-colors',
            isBlog
              ? 'text-[var(--text-primary)]'
              : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)]',
          ]}
        >
          Blog
        </a>
        <a
          href="/tags/"
          class:list={[
            'text-sm font-medium transition-colors',
            isTags
              ? 'text-[var(--text-primary)]'
              : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)]',
          ]}
        >
          Topics
        </a>
        <a
          href="/page/about/"
          class:list={[
            'text-sm font-medium transition-colors',
            isAbout
              ? 'text-[var(--text-primary)]'
              : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)]',
          ]}
        >
          About
        </a>
      </nav>
    </div>

    <!-- Right Controls -->
    <div class="flex items-center gap-3">
      <nav class="flex sm:hidden items-center gap-4 mr-1" aria-label="Mobile Navigation">
        <a href="/" class="text-sm font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)]">Blog</a>
        <a href="/tags/" class="text-sm font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)]">Topics</a>
        <a href="/page/about/" class="text-sm font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)]">About</a>
      </nav>

      <button
        type="button"
        data-search-trigger
        class="flex items-center gap-2 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-canvas)] px-2.5 py-1 text-xs text-[var(--text-secondary)] transition hover:border-[var(--border-hover)] hover:text-[var(--text-primary)] cursor-pointer"
        aria-label="Search articles"
        title="Search (⌘K or /)"
      >
        <svg class="h-3.5 w-3.5 text-[var(--text-muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden sm:inline">Search</span>
        <kbd class="hidden md:inline-block font-mono text-[10px] text-[var(--text-muted)]">⌘K</kbd>
      </button>

      <button
        type="button"
        id="theme-toggle"
        class="flex h-7 w-7 items-center justify-center rounded-md border border-[var(--border-subtle)] bg-[var(--bg-canvas)] text-[var(--text-secondary)] transition hover:border-[var(--border-hover)] hover:text-[var(--text-primary)] cursor-pointer"
        aria-label="Toggle color theme"
        title="Toggle light/dark mode"
      >
        <svg data-theme-icon="sun" class="h-3.5 w-3.5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m8.66-11.66l-.7.7M4.04 19.96l-.7.7M21 12h-1M4 12H3m16.96 7.96l-.7-.7M4.74 4.74l-.7-.7M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg data-theme-icon="moon" class="h-3.5 w-3.5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    const sun = btn?.querySelector('[data-theme-icon="sun"]');
    const moon = btn?.querySelector('[data-theme-icon="moon"]');

    function syncIcons(theme) {
      if (!sun || !moon) return;
      if (theme === 'light') {
        sun.classList.add('hidden');
        moon.classList.remove('hidden');
      } else {
        sun.classList.remove('hidden');
        moon.classList.add('hidden');
      }
    }

    const current = document.documentElement.getAttribute('data-theme') || 'light';
    syncIcons(current);

    btn?.addEventListener('click', () => {
      const active = document.documentElement.getAttribute('data-theme') || 'light';
      const next = active === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('ts-theme', next);
      syncIcons(next);
      window.dispatchEvent(new CustomEvent('studio:theme-change', { detail: { theme: next } }));
    });
  })();
</script>
