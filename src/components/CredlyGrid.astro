---
interface Badge {
  id: string;
  label: string;
  issuer: string;
}

const badges: Badge[] = [
  {
    id: 'f3244186-4287-4253-a05f-b05a1a1017ef',
    label: 'Verified Credential #01',
    issuer: 'Credly Verification',
  },
  {
    id: '215d0838-0830-4da8-8ffb-ba90dd821392',
    label: 'Verified Credential #02',
    issuer: 'Credly Verification',
  },
  {
    id: '8fcb5db2-8db0-42c9-8078-d05d6b30ff1d',
    label: 'Verified Credential #03',
    issuer: 'Credly Verification',
  },
  {
    id: '9c75f8cb-19d9-4ab2-9f30-2900fc88b199',
    label: 'Verified Credential #04',
    issuer: 'Credly Verification',
  },
  {
    id: '618f6171-828d-4bd7-a320-e48ff51eca5b',
    label: 'Verified Credential #05',
    issuer: 'Credly Verification',
  },
  {
    id: 'b7730a22-302e-4438-9a59-3c97d7b2e33c',
    label: 'Verified Credential #06',
    issuer: 'Credly Verification',
  },
  {
    id: 'bbee878c-078a-48f8-aa87-8e5f403a66c8',
    label: 'Verified Credential #07',
    issuer: 'Credly Verification',
  },
];
---

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {
    badges.map((badge) => (
      <div class="group flex flex-col items-center justify-between rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-5 transition hover:border-[var(--border-hover)] hover:bg-[var(--bg-elevated)]/60">
        <!-- Official Credly Embed Container -->
        <div
          data-iframe-width="150"
          data-iframe-height="270"
          data-share-badge-id={badge.id}
          data-share-badge-host="https://www.credly.com"
        />

        <!-- Direct Verification Link Fallback / Footer -->
        <div class="mt-3 flex w-full items-center justify-between border-t border-[var(--border-subtle)] pt-3 font-mono text-[11px]">
          <span class="truncate text-[var(--text-muted)]" title={badge.id}>
            ID: {badge.id.slice(0, 8)}…
          </span>
          <a
            href={`https://www.credly.com/badges/${badge.id}`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--accent-primary)] hover:underline"
          >
            Verify ↗
          </a>
        </div>
      </div>
    ))
  }
</div>

<script type="text/javascript" async src="//cdn.credly.com/assets/utilities/embed.js" is:inline></script>
