---
import { withBase } from '../utils/paths';

const year = new Date().getFullYear();
const disclaimerText =
  "The opinions expressed herein are my own personal opinions and do not represent my employer’s view in any way.";
---

<footer class="mt-20 border-t border-[var(--border-subtle)] bg-[var(--bg-surface)]">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-center">
      <div class="max-w-xl space-y-1.5">
        <div class="text-sm font-semibold text-[var(--text-primary)]">
          Josh Wright
        </div>
        <p class="text-xs leading-relaxed text-[var(--text-muted)]">
          {disclaimerText}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-6 text-xs font-medium text-[var(--text-secondary)]">
        <a
          href="https://github.com/joshwright10"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-[var(--text-primary)] hover:underline"
        >
          GitHub
        </a>
        <a
          href="https://www.linkedin.com/in/joshwright10"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-[var(--text-primary)] hover:underline"
        >
          LinkedIn
        </a>
        <a
          href={withBase('/rss.xml')}
          class="hover:text-[var(--text-primary)] hover:underline"
        >
          RSS
        </a>
      </div>
    </div>

    <div class="mt-8 border-t border-[var(--border-subtle)] pt-6 text-xs text-[var(--text-muted)]">
      © {year} Josh Wright
    </div>
  </div>
</footer>
