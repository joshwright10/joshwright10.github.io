  <div class="giscus-container rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-4 sm:p-6">
    <script
      src="https://giscus.app/client.js"
      data-repo="joshwright10/joshwright10.github.io"
      data-repo-id="MDEwOlJlcG9zaXRvcnkxOTYwODUyODY="
      data-category="Announcements"
      data-category-id="DIC_kwDOC7AGJs4CUzdm"
      data-mapping="url"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="bottom"
