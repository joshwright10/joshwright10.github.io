---
interface Props {
  slug: string;
  title: string;
  date: Date;
  description?: string;
  tags?: string[];
  body?: string;
  featured?: boolean;
}

const { slug, title, date, description, tags = [], body = '', featured = false } = Astro.props;

const wordCount = body.trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 215));

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

function extractExcerpt(raw: string, fallback?: string): string {
  if (fallback) return fallback;
  const paragraphs = raw
    .replace(/```[\s\S]*?```/g, '')
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter((p) => p && !p.startsWith('#') && !p.startsWith('-') && !p.startsWith('<'));
  const first = paragraphs[0] || '';
  return first
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[*_`~]/g, '')
    .slice(0, 260);
}

const excerpt = extractExcerpt(body, description);
const primaryTopics = tags.slice(0, 3).map((t) => t.replace(/-/g, ' '));
---

<article
  data-post-card
  data-tags={tags.join(',')}
  class:list={[
    'group flex flex-col justify-between py-7 border-b border-[var(--border-subtle)]',
    featured && 'py-0 border-b-0',
  ]}
>
  <div>
    {
      primaryTopics.length > 0 && (
        <div class="mb-2.5 flex flex-wrap items-center gap-2 text-xs font-medium uppercase tracking-wider text-[var(--accent-primary)]">
          {primaryTopics.map((topic, idx) => (
            <>
              {idx > 0 && <span class="text-[var(--border-hover)]">·</span>}
              <span>{topic}</span>
            </>
          ))}
        </div>
      )
    }

    <h2
      class:list={[
        'font-semibold tracking-tight text-[var(--text-primary)] transition-colors group-hover:text-[var(--accent-primary)]',
        featured ? 'text-2xl sm:text-3xl lg:text-[2.15rem] leading-[1.2]' : 'text-xl sm:text-[1.35rem] leading-[1.3]',
      ]}
    >
      <a href={`/posts/${slug}/`} class="focus:outline-none">
        {title}
      </a>
    </h2>

    {
      excerpt && (
        <p
          class:list={[
            'mt-3 leading-relaxed text-[var(--text-secondary)]',
            featured ? 'text-base sm:text-[1.0625rem] max-w-3xl' : 'text-[0.95rem] line-clamp-3',
          ]}
        >
          {excerpt}
        </p>
      )
    }
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-2 text-xs text-[var(--text-muted)]">
    <span class="font-medium text-[var(--text-secondary)]">Josh Wright</span>
    <span>·</span>
    <time datetime={date.toISOString()}>{formattedDate}</time>
    <span>·</span>
    <span>{readingMinutes} min read</span>
  </div>
</article>
