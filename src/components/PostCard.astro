---
interface Props {
  slug: string;
  title: string;
  date: Date;
  description?: string;
  tags?: string[];
  body?: string;
  featured?: boolean;
}

const { slug, title, date, description, tags = [], body = '', featured = false } = Astro.props;

const wordCount = body.trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 215));

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
});

// Check if article contains Mermaid diagrams
const diagramCount = (body.match(/```mermaid/g) || []).length;
---

<article
  data-post-card
  data-tags={tags.join(',')}
  class:list={[
    'group relative flex flex-col justify-between rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-[var(--border-hover)] hover:bg-[var(--bg-elevated)]/80 hover:shadow-xl',
    featured && 'md:col-span-2 bg-gradient-to-br from-[var(--bg-surface)] via-[var(--bg-surface)] to-[var(--bg-elevated)]',
  ]}
>
  <div>
    <!-- Meta Bar -->
    <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-xs text-[var(--text-muted)]">
      <div class="flex items-center gap-2">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        <span>·</span>
        <span>{readingMinutes} min read</span>
        {
          diagramCount > 0 && (
            <>
              <span>·</span>
              <span class="inline-flex items-center gap-1 rounded border border-[var(--border-subtle)] bg-[var(--bg-canvas)] px-1.5 py-0.5 text-[10px] text-[var(--accent-primary)]">
                {diagramCount} {diagramCount === 1 ? 'diagram' : 'diagrams'}
              </span>
            </>
          )
        }
      </div>
      {
        featured && (
          <span class="rounded-full border border-[var(--accent-primary)]/30 bg-[var(--accent-primary)]/10 px-2.5 py-0.5 text-[10px] font-medium uppercase tracking-wider text-[var(--accent-primary)]">
            Latest Field Note
          </span>
        )
      }
    </div>

    <!-- Title -->
    <h2 class:list={['mt-3 font-semibold tracking-tight text-[var(--text-primary)] transition group-hover:text-[var(--accent-primary)]', featured ? 'text-xl sm:text-2xl' : 'text-lg sm:text-xl']}>
      <a href={`/posts/${slug}/`} class="before:absolute before:inset-0">
        {title}
      </a>
    </h2>

    <!-- Description -->
    {
      description && (
        <p class="mt-2.5 text-sm leading-relaxed text-[var(--text-secondary)] line-clamp-3">
          {description}
        </p>
      )
    }
  </div>

  <!-- Tags & Read link -->
  <div class="mt-6 flex items-center justify-between gap-4 border-t border-[var(--border-subtle)] pt-4">
    <div class="relative z-10 flex flex-wrap gap-1.5">
      {
        tags.slice(0, 5).map((tag) => (
          <a
            href={`/tags/${tag}/`}
            class="rounded-md border border-[var(--border-subtle)] bg-[var(--bg-canvas)] px-2 py-0.5 font-mono text-[11px] text-[var(--text-muted)] transition hover:border-[var(--border-hover)] hover:text-[var(--accent-primary)]"
          >
            #{tag}
          </a>
        ))
      }
      {
        tags.length > 5 && (
          <span class="rounded-md px-1.5 py-0.5 font-mono text-[11px] text-[var(--text-muted)]">
            +{tags.length - 5}
          </span>
        )
      }
    </div>

    <span class="font-mono text-xs font-medium text-[var(--accent-primary)] opacity-80 transition group-hover:translate-x-0.5 group-hover:opacity-100 shrink-0">
      Read →
    </span>
  </div>
</article>
